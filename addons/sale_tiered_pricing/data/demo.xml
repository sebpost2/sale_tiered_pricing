<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fictitious example, loaded only with demo data: 120 chairs reach the 15% tier, and that line pulls
         the whole quotation's margin (about 23.6%) under the 25% minimum, so the margin guard shows. -->
    <record id="demo_tier_10" model="sale.pricing.tier">
        <field name="name">10+</field>
        <field name="min_qty">10</field>
        <field name="discount_percent">5</field>
    </record>
    <record id="demo_tier_50" model="sale.pricing.tier">
        <field name="name">50+</field>
        <field name="min_qty">50</field>
        <field name="discount_percent">10</field>
    </record>
    <record id="demo_tier_100" model="sale.pricing.tier">
        <field name="name">100+</field>
        <field name="min_qty">100</field>
        <field name="discount_percent">15</field>
    </record>

    <record id="base.main_company" model="res.company">
        <field name="margin_guard_min_percent">25</field>
    </record>

    <record id="demo_customer" model="res.partner">
        <field name="name">Oficinas Misti SAC</field>
        <field name="is_company" eval="True"/>
    </record>
    <record id="demo_product_chair" model="product.product">
        <field name="name">Silla ergonómica</field>
        <field name="type">consu</field>
        <field name="list_price">450</field>
        <field name="standard_price">300</field>
    </record>
    <record id="demo_product_desk" model="product.product">
        <field name="name">Escritorio de melamina</field>
        <field name="type">consu</field>
        <field name="list_price">900</field>
        <field name="standard_price">500</field>
    </record>

    <record id="demo_quotation" model="sale.order">
        <field name="partner_id" ref="demo_customer"/>
        <field name="order_line" eval="[
            Command.create({'product_id': ref('demo_product_chair'), 'product_uom_qty': 120}),
            Command.create({'product_id': ref('demo_product_desk'), 'product_uom_qty': 5}),
        ]"/>
    </record>
</odoo>
